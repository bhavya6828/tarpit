# ─── Deepgram (streaming STT — listens to the scammer) ───────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ─── ElevenLabs (streaming TTS — the persona's voice) ────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ─── OpenAI (persona brain + intel enrichment) ──────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EXTRACT_MODEL=gpt-4o-mini

# ─── Elastic (threat-intel index — "signal in the noise") ───────────────────
# Elastic Cloud:
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=
# ...or self-hosted:
ELASTIC_NODE=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8787
# Blended scammer operating cost, USD/minute (call carriage + labor + floor)
SCAMMER_COST_PER_MINUTE=0.42
# Avg successful scam call length in seconds, used for "victims shielded"
AVG_SCAM_CALL_SECONDS=270
